DATABASE_URL=mysql+asyncmy://realtimeorders_app:CHANGE_ME@127.0.0.1:3306/realtimeorders?charset=utf8mb4
APP_SECRET=GENERATE_WITH_python_-c_import_secrets_print_secrets.token_hex_32
APP_ORIGIN=https://localhost:3443
COOKIE_SECURE=true
SMS_PROVIDER=demo
EMAIL_PROVIDER=demo
# Demo codes are returned ONLY with DEMO_MODE=true. Never use for live customers.
DEMO_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ZBS OTP template; the OA/app must be authorized and the template approved.
# Never commit real credentials. The template must contain this code field.
ZALO_ACCESS_TOKEN=
ZALO_OTP_TEMPLATE_ID=
ZALO_OTP_CODE_FIELD=otp

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
UPLOAD_DIR=runtime/uploads

# Address lookup and routing defaults use public OpenStreetMap Nominatim/OSRM services; no API key is required.
# You can point these URLs at services you operate yourself. Public endpoints are rate-limited and are for demos.
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

PHOTON_URL=https://photon.komoot.io

# Optional live payOS. Keep blank until a verified payment channel is configured.
# Webhook: APP_ORIGIN/api/v1/payments/payos/webhook (public HTTPS).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_TTL_SECONDS=900

# Configure both Google Maps keys and select google to enable Google Maps.
MAP_PROVIDER=osm
VIETMAP_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
